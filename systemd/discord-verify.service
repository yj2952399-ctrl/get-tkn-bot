[Unit]
Description=Discord Verify Bot
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/discord-verify
EnvironmentFile=/opt/discord-verify/.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=3
User=verify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/discord-verify/data

[Install]
WantedBy=multi-user.target